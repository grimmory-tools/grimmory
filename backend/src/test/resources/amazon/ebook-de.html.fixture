ngs-histogram_style_histogram-column-space__RKUAd" aria-hidden="true">25%</span><span class="_cr-ratings-histogram_style_histogram-column-space__RKUAd" aria-hidden="true">7%</span><span class="_cr-ratings-histogram_style_histogram-column-space__RKUAd" aria-hidden="true">2%</span><span class="_cr-ratings-histogram_style_histogram-column-space__RKUAd" aria-hidden="true">0%</span>0%</div></span></div></span></li></ul></div></div></div></div><div class="a-fixed-left-grid a-spacing-none"><div class="a-fixed-left-grid-inner"><div class="a-fixed-left-grid-col a-col-left"><div class="a-row a-expander-container a-spacing-top-medium a-expander-inline-container"><a data-csa-c-func-deps="aui-da-a-expander-toggle" data-csa-c-type="widget" data-csa-interaction-events="click" data-hook="cr-ratings-explanation-expand" aria-expanded="false" role="button" href="javascript:void(0)" data-action="a-expander-toggle" class="a-expander-header a-declarative a-expander-inline-header a-link-expander" data-a-expander-toggle="{&quot;allowLinkDefault&quot;:true, &quot;expand_prompt&quot;:&quot;&quot;, &quot;collapse_prompt&quot;:&quot;&quot;}" data-csa-c-id="4qsgay-k32rv8-l8o99q-i5kgmx"><i class="a-icon a-icon-expand"></i><span class="a-expander-prompt">So funktionieren Kundenrezensionen und -bewertungen</span></a><div data-expanded="false" class="a-expander-content a-expander-inline-content a-expander-inner"><p class="a-spacing-top-small">Kundenbewertungen, einschließlich Produkt-Sternebewertungen, helfen Kunden, mehr über das Produkt zu erfahren und zu entscheiden, ob es das richtige Produkt für sie ist.</p><p>Um die Gesamtbewertung der Sterne und die prozentuale Aufschlüsselung nach Sternen zu berechnen, verwenden wir keinen einfachen Durchschnitt. Stattdessen berücksichtigt unser System beispielsweise, wie aktuell eine Bewertung ist und ob der Prüfer den Artikel bei Amazon gekauft hat. Es wurden auch Bewertungen analysiert, um die Vertrauenswürdigkeit zu überprüfen.</p><a class="a-link-normal" target="_blank" rel="noopener" href="/gp/help/customer/display.html/ref=cm_cr_dp_d_omni_lm_btn?nodeId=G8UYX7LALQC8V9KA">Erfahren Sie mehr darüber, wie Kundenbewertungen bei Amazon funktionieren.</a></div></div></div></div></div></div></div></div></div></span><span class="cr-lazy-widget cr-reviews-ai-pills-t1" data-widget-name="cr-reviews-ai-pills-t1"></span><hr aria-hidden="true" class="a-spacing-large a-spacing-top-large a-divider-normal"><span class="cr-lazy-widget cr-age-recommendation" data-widget-name="cr-age-recommendation"><div class="celwidget c-f" cel_widget_id="waldo-customer-reviews-dp-ingress_customer-reviews-detail-cra_0" data-csa-op-log-render="" data-csa-c-content-id="DsUnknown" data-csa-c-slot-id="DsUnknown-1" data-csa-c-type="widget" data-csa-c-painter="waldo-customer-reviews-dp-ingress-cards" data-csa-c-id="zltg9-u0e5nk-hlqf3n-f9mpo7" data-cel-widget="waldo-customer-reviews-dp-ingress_customer-reviews-detail-cra_0"><style>._waldo-customer-reviews-dp-ingress_style_readingAgeContainer__102ao{-webkit-box-pack:justify;-ms-flex-pack:justify;-webkit-box-align:center;-ms-flex-align:center;align-items:center;background:inherit;border-radius:5px;box-sizing:border-box;color:#565959;display:-webkit-box;display:-ms-flexbox;display:flex;font-family:Arial,sans-serif;font-size:14px;font-weight:400;justify-content:space-between;max-width:inherit;padding:0;width:100%}._waldo-customer-reviews-dp-ingress_style_readingAgeLabel__1WEHq{-webkit-box-flex:1;-ms-flex-positive:1;color:inherit;flex-grow:1}._waldo-customer-reviews-dp-ingress_style_readingAgeValue__3qmth{color:inherit;text-align:right}._waldo-customer-reviews-dp-ingress_toysStyle_toys-cra-info-icon__2xm3w{-webkit-box-align:center;-ms-flex-align:center;-webkit-box-pack:center;-ms-flex-pack:center;align-items:center;background-color:#696969;border-radius:50%;color:#fff;cursor:pointer;display:-webkit-inline-box;display:-ms-inline-flexbox;display:inline-flex;font-size:9px;height:13px;justify-content:center;margi