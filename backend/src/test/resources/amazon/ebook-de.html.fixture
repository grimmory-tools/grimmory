ewContainer" data-translatable="false" data-reviewid="R1VTMGX7GLXEGM" data-asin="B01BLSRIX6" data-mobile="false" data-locale="de-DE" data-localelanguagename="Deutsch" data-sourcelanguage="de-DE" data-sourcelanguagename="Deutsch" data-iscustomerrecognized="false" data-iskindleapp="false" data-isandroidapp="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="A1PA6795UKMFR9"><div id="R1VTMGX7GLXEGM" data-csa-c-slot-id="customer_review-R1VTMGX7GLXEGM" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="ugkljb-p94nt7-e7ei27-klpihf"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="/gp/profile/amzn1.account.AFXXDWDYRI3YUWTDEZ72NT2BYELA?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R1VTMGX7GLXEGM_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="cidsxo-lcccgl-9mygvv-so4ux2"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png" data-src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"><noscript><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">Bewee</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-5"><span class="a-icon-alt">5 von 5&nbsp;Sternen</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="/portal/customer-reviews/srp/-/R1VTMGX7GLXEGM/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="de-DE">...und der zweite Streich, folgt zugleich...</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Bewertet in Deutschland am 23. Mai 2016</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="/portal/customer-reviews/B01BLSRIX6/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Formatieren: Kindle</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verifizierter Kauf</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-8"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-8-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-8-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="peekExpand" name="a-cardui-deck-autoname-8-card0" data-csa-c-id="ivt717-v0odcc-hd3rn8-27urv2"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="de-DE" class="_Y3Itd_contain-rich-content_2IORW"><p><span>Dieses Buch knüpft in leichten Zügen an das erste Buch (Leid kennt keinen Sonntag) an. Die Tehamtik ist eine andere, wobei vergangene Szenen oder Inhalte des ersten Teils aufgegriffen werden. Nichtsdetrotrotz würde sich dieses Buch auch ohne den ersten Teil lesen lassen.</span></p><p><span>Aber tut es besser nicht ohne den ersten Teil ;-)</span></p><p><span>Der Inhalt ist schon allgemein bekannt, deshalb beschränke ich mich hier auf die Leseerfahrung.</span></p><p><span>Bereits im Vorgängerbuch habe ich die die Schreibweise von Tahriot und Sam gelobt, in der eine Szene aus der Sicht unterschiedlicher Charaktere geschildert wurde. Dies haben die beidene hier fortgesetzt, jedoch mit eine wesentlich besseren und emotionaleren Perspektive. Es werden nicht nur bloße Handlungsstränge aus verschiedenen Sichten geschildert, die Charaktere gewinnen nochmals mehr an Tiefe indem die Gefühle viel besser hervorgehoben werden. Das ganze tut der Action und der Spannung keinen Schaden wie ich anfangs dachte. Man lebt sich quasi immer weider neu in die Charaktere ein, man switched hin und her und es macht einfach Spass sich "switchen zu lassen" :D</span></p><p><span>Ich muss zugeben, die Thematik des ersten Bandes fand ich etwas besser. Aaaaaaaber das ist geschmackssache.</span></p><p><span>Kaufen !!!</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="vaj944-q5dfuz-y59d2q-6kulhn"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text">Mehr erfahren</span><span class="a-see-less-text">Weniger anzeigen</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-top-small _Y3Itd_helpful-votes-container_3iphI"><span data-hook="helpful-vote-statement" class="a-size-base a-color-tertiary">Eine Person fand diese Informationen hilfreich</span></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vote-action-bar_10AyR"><div data-hook="helpfulVoteWidget" class="a-section a-spacing-none _Y3Itd_cr-voting-section_1cNTp"><div class="_Y3Itd_cr-helpful-button_1u3UK cr-vote-component" data-hook="helpfulVoteButton" data-mix-operations="HelpfulVoteClickHandler" data-asin="B01BLSRIX6" data-id="R1VTMGX7GLXEGM" data-return-to="DpReview" data-csa-c-type="element" data-csa-c-slot-id="customer_review-R1VTMGX7GLXEGM_helpful_button" data-csa-c-id="no9p6f-885jnv-vwq44t-t2t1xp"><span class="a-button a-button-base" id="a-autoid-28"><span class="a-button-inner"><input type="submit" class="a-button-input" aria-labelledby="a-autoid-28-announce"><span class="a-button-text" aria-hidden="true" id="a-autoid-28-announce"><div class="_Y3Itd_cr-helpful-text-desktop_2dXQG">Hilfreich</div></span></span></span></div><span data-hook="helpfulVoteLoadingMessage" class="_Y3Itd_hidden_1J5OD">Feedback wird gesendet&nbsp;...</span><div data-hook="helpfulVoteSuccessMessage" class="a-box a-alert-inline a-alert-inline-success _Y3Itd_hidden_1J5OD a-spacing-block" aria-live="polite" aria-atomic="true"><div class="a-box-inner a-alert-container"><i class="a-icon a-icon-alert" aria-hidden="true"></i><div class="a-alert-content">Vielen Dank für dein Feedback.</div></div></div><div data-hook="helpfulVoteErrorMessage" class="a-box a-alert-inline a-alert-inline-error _Y3Itd_hidden_1J5OD a-spacing-block" role="alert"><div class="a-box-inner a-alert-container"><i cla