go1s-3cafc4-kfgbdu" data-cel-widget="promoPriceBlockMessage_feature_div"><div></div></div><div id="dynamicIframe_feature_div" class="celwidget" data-feature-name="dynamicIframe" data-csa-c-type="widget" data-csa-c-content-id="dynamicIframe" data-csa-c-slot-id="dynamicIframe_feature_div" data-csa-c-asin="" data-csa-c-is-in-initial-active-row="false" data-csa-c-id="mwa7vn-p9ptd0-gke17w-c3114c" data-cel-widget="dynamicIframe_feature_div"></div><div id="kindleInMotion_feature_div" class="celwidget" data-feature-name="kindleInMotion" data-csa-c-type="widget" data-csa-c-content-id="kindleInMotion" data-csa-c-slot-id="kindleInMotion_feature_div" data-csa-c-asin="" data-csa-c-is-in-initial-active-row="false" data-csa-c-id="2czen-qgvcqa-hikkhq-jyohsd" data-cel-widget="kindleInMotion_feature_div"></div><div id="twisterPlusWWDesktop" class="celwidget" data-feature-name="twisterPlusWWDesktop" data-csa-c-type="widget" data-csa-c-content-id="twisterPlusWWDesktop" data-csa-c-slot-id="twisterPlusWWDesktop" data-csa-c-asin="" data-csa-c-is-in-initial-active-row="false" data-csa-c-id="a9869h-bfap04-rvtsx1-p3dp76" data-cel-widget="twisterPlusWWDesktop"></div><div id="productOverview_feature_div" class="celwidget" data-feature-name="productOverview" data-csa-c-type="widget" data-csa-c-content-id="productOverview" data-csa-c-slot-id="productOverview_feature_div" data-csa-c-asin="" data-csa-c-is-in-initial-active-row="false" data-csa-c-id="mwqljx-db7336-ejc43c-dsz7r6" data-cel-widget="productOverview_feature_div"></div><div id="provenanceCertifications_feature_div" class="celwidget" data-feature-name="provenanceCertifications" data-csa-c-type="widget" data-csa-c-content-id="provenanceCertifications" data-csa-c-slot-id="provenanceCertifications_feature_div" data-csa-c-asin="" data-csa-c-is-in-initial-active-row="false" data-csa-c-id="itwu13-4wj3ru-mr0rkp-74vrxx" data-cel-widget="provenanceCertifications_feature_div"></div><div id="bookDescription_feature_div" class="celwidget" data-feature-name="bookDescription" data-csa-c-type="widget" data-csa-c-content-id="bookDescription" data-csa-c-slot-id="bookDescription_feature_div" data-csa-c-asin="" data-csa-c-is-in-initial-active-row="false" data-csa-c-id="u8zh9h-ga6y10-i6kr67-pc0zrf" data-cel-widget="bookDescription_feature_div"><div data-a-expander-name="book_description_expander" data-a-expander-collapsed-height="280" class="a-expander-collapsed-height a-row a-expander-container a-spacing-base a-expander-partial-collapse-container" style="height:280px;max-height:none;"><div data-expanded="false" class="a-expander-content a-expander-partial-collapse-content" style="padding-bottom:22px;"><span>Düsseldorf im August. Ein Giftanschlag auf unser Trinkwasser. Menschen sterben und die Behörden setzen alle Hebel in Bewegung, dort zu suchen, wo nichts zu finden ist. <br>Noch 152 Stunden. <br><br>Der Hacker weiß nicht, wie ihm geschieht. Sein Vormund will ihn entmündigen lassen, seine Großmutter liegt vergiftet im Krankenhaus und seinen neuen Job hat er nicht zufällig bekommen. <br>Noch 137 Stunden. <br><br>Die Putzfrau flieht vor ihrer Vergangenheit, jedoch nicht schnell genug. Die Ereignisse zwingen sie zum dümmsten Fehler, den man in ihrer Branche begehen kann. Sie muss vertrauen. <br>Noch 98 Stunden. <br><br>Der Kommissar wird in die EU-Umweltbehörde weggelobt. Der langweiligste Job der Welt. Sein erster Fall beginnt mit Kröten und Pferden; er nimmt eine Wasserprobe in einer Talsperre. <br>Noch 79 Stunden. <br><br></span><h2><span>EchtzeiT – Wer die Wahrheit quält</span></h2><span><br>Der Kommissar, die Putzfrau und der Hacker, drei Leben und keine Gerechtigkeit. Jetzt noch wahrer – ein Spiel gegen 100.000 Lügen. <br><br><br></span><span class="a-text-bold">EchtzeiT</span><span><br>2015 »Leid kennt keinen Sonntag« <br>2016 »Wer die Wahrheit quält« <br>2016 »Gier frisst jede Tugend« <br><br>Liljanas' Rezensionen: EchtzeiT "Leid kennt keinen Sonntag" ist ein Buch, bei dem sich die Story vor dem inneren Auge abspielt. Ich war von Beginn an mitten im Geschehen und pumpte wahrlich ebenso viel Adrenalin durch meinen Körper wie unsere drei Freunde. Ich kann nur noch sagen, lest es! Ich liebe es und möchte bitte mehr davon! <br><br></span><span class="a-text-bold">NEU</span><span><br>2017 »Instabil - Die Vergangenheit ist noch nicht geschehen«</span></div><div class="a-expander-header a-expander-partial-collapse-header" style="opacity:1;display:block;"><div class="a-expander-content-fade"></div><a href="javascript:void(0)" role="button" data-action="a-expander-toggle" class="a-declarative" data-a-expander-toggle="{&quot;allowLinkDefault&quot;:true, &quot;expand_prompt&quot;:&quot;Mehr lesen&quot;, &quot;collapse_prompt&quot;:&quot;Weniger lesen&quot;}"><i class="a-icon a-icon-extender-expand"></i><span class="a-expander-prompt">Mehr lesen</span></a></div></div></div><div id="hushpuppyUpsell_feature_div" class="celwidget" data-feature-name="hushpuppyUpsell" data-csa-c-type="widget" data-csa-c-content-id="hushpuppyUpsell" data-csa-c-slot-id="hushpuppyUpsell_feature_div" data-csa-c-asin="" data-csa-c-is-in-initial-active-row="false" data-csa-c-id="c8labj-l2yfa-6h1nra-3mum7" data-cel-widget="hushpuppyUpsell_feature_div"></div><div id="richProductInformation_feature_div" class="celwidget" data-feature-name="richProductInformation" data-csa-c-type="widget" data-csa-c-content-id="richProductInformation" data-csa-c-slot-id="richProductInformation_feature_div" data-csa-c-asin="" data-csa-c-is-in-initial-active-row="false" data-csa-c-id="9vsrdu-8bes8w-d1pdot-3i827a" data-cel-widget="richProductInformation_feature_div"><div id="rich_product_information" class="a-section a-spacing-none celwidget" data-csa-c-id="l9mpmp-gbpwjd-b9402h-qweaa4" data-cel-widget="rich_product_information"><hr aria-hidden="true" class="a-spacing-none a-divider-normal"><div data-a-carousel-options="{&quot;set_size&quot;:9,&quot;name&quot;:&quot;rich-product-information-carousel&quot;,&quot;auto_adjust_height&quot;: