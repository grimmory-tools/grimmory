er-content-R3KLE90XOY9E6L"><div class="_Y3Itd_media-popover-content-wrapper_3MziH"><div class="_Y3Itd_media-popover-background-wrapper_2UMSb"><div class="_Y3Itd_page-indicator-container_1X84N"><div class="_Y3Itd_media-popover-page-indicator_10KaA" data-hook="PageIndicator"></div></div><div class="_Y3Itd_media-popover-topbar_knKqX"><button data-popover-id="R3KLE90XOY9E6L" class="_Y3Itd_close-button_2RG2d" data-hook="ReviewMediaPopoverCloseButton" data-mix-operations="ReviewMediaPopoverCloseButtonClickHandler" data-csa-c-type="element" data-csa-c-id="l61tl1-n3rqma-3byulv-x9u95v"><i class="a-icon a-icon-close-white a-icon-medium" role="presentation"></i></button></div><div class="_Y3Itd_media-popover-media-list-view-container_1kFg1" data-hook="ReviewMediaList"><button data-popover-id="R3KLE90XOY9E6L" class="_Y3Itd_media-popover-media-list-overlay_2x3M5" data-mix-operations="ReviewMediaPopoverNextMediaClickHandler"></button></div></div></div></div></div></div></div></div></span></li><li><span class="a-list-item"><div data-hook="reviewContainer" data-translatable="false" data-reviewid="R2JNCZ34LBXNEB" data-asin="B01BLSRIX6" data-mobile="false" data-locale="de-DE" data-localelanguagename="Deutsch" data-sourcelanguage="de-DE" data-sourcelanguagename="Deutsch" data-iscustomerrecognized="false" data-iskindleapp="false" data-isandroidapp="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="A1PA6795UKMFR9"><div id="R2JNCZ34LBXNEB" data-csa-c-slot-id="customer_review-R2JNCZ34LBXNEB" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="a4smnb-dpoui9-jq40x7-h2zugv"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="/gp/profile/amzn1.account.AGHSBPM76IQCHQGWCVV7WPBI7TLA?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R2JNCZ34LBXNEB_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="ayyat2-7tpsuf-7a94xd-stngqb"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png" data-src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"><noscript><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">Andreas L.</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-4"><span class="a-icon-alt">4 von 5&nbsp;Sternen</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="/portal/customer-reviews/srp/-/R2JNCZ34LBXNEB/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="de-DE">Sehr spannend, aber teilweise zu einfach</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Bewertet in Deutschland am 28. November 2017</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="/portal/customer-reviews/B01BLSRIX6/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Formatieren: Kindle</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verifizierter Kauf</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-3"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-3-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-3-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="basic" name="a-cardui-deck-autoname-3-card0" data-csa-c-id="6cm0hx-akitwt-3cfgj8-ejret9"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="de-DE" class="_Y3Itd_contain-rich-content_2IORW"><p><span>Das Buch, bzw., die Trilogie, der beiden deutschen Autoren ist durchweg spannend, gerade aufgrund des quasi mitlaufenden Countdowns. Die Autoren haben es geschafft mich durch alle drei Teile dauerhaft bei der Stange zu halten. Die Protagonisten werden sehr bildlich dargestellt und man fühlt durch die gesamte Handlung mit Ihnen. Die in der nahen Zukunft angesiedelte Handlung macht Spaß, gerade die erdachten technischen Weiterentwicklungen sind spannend zu verfolgen. Hierbei verlieren sich die Autoren nicht in Wunschträumen oder ausufernder Fantasie, sondern denken die aktuell im Jahre 2017 vorhandene Technik einfach einen Schritt weiter. Ob die reale Entwicklung in diese Richtung geht, sei mal dahingestellt.</span></p><p><span>Mein einziger Kritikpunkt, weshalb auch "nur" 4 Sterne gegeben wurden, ist, dass sich die Situationen des männlichen Protagonisten oftmals zu einfach lösen lassen. Natürlich ist sein "Helferlein" einer der Clous der ganzen Storyline, aber manchmal hatte ich das Gefühl, dass es sich die Autoren damit zu einfach gemacht haben ihn aus den brenzlichsten Situationen zu holen.</span></p><p><span>Alles in allem aber wie gesagt eine durchaus lesenswerte Trilogie die von mir 4,5 Sterne erhält.</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha a-hidden"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="79jzfk-xu4bvw-9drgzy-3y0v6s"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text">Mehr erfahren</span><span class="a-see-less-text">Weniger anzeigen</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vote-action-bar_10AyR"><div data-hook="helpfulVoteWidget" class="a-section a-spacing-none _Y3Itd_cr-voting-section_1cNTp"><div class="_Y3Itd_cr-helpful-button_1u3UK cr-vote-component" data-hook="helpfulVoteButton" data-mix-operations="HelpfulVoteClickHandler" data-asin="B01BLSRIX6" data-id="R2JNCZ34LBXNEB" data-return-to="DpReview" data-csa-c-type="element" data-csa-c-slot-id="customer_review-R2JNCZ34LBXNEB_helpful_button" data-csa-c-id="h7jpit-q93kx0-a0z2ha-mwse3q"><span class="a-button a-button-base" id="a-autoid-23"><span class="a-button-inner"><input type="submit" class="a-button-input" aria-labelledby="a-autoid-23-announce"><span class="a-button-text" aria-hidden="true" id=