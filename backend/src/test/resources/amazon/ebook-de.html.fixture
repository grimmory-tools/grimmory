app="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="A1PA6795UKMFR9"><div id="R25P6ECO7E5G6M" data-csa-c-slot-id="customer_review-R25P6ECO7E5G6M" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="cgeeb7-la30c0-j0bwn1-u8pfkh"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="/gp/profile/amzn1.account.AF5JXWIKRON35AJNGB5RIL5GPEGA?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R25P6ECO7E5G6M_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="as5yb6-qcpj96-i6m7b0-yqkj9n"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png" data-src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"><noscript><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">Terry</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-5"><span class="a-icon-alt">5 von 5&nbsp;Sternen</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="/portal/customer-reviews/srp/-/R25P6ECO7E5G6M/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="de-DE">Ich brauche mehr Sterne, 5 reichen einfach nicht!</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Bewertet in Deutschland am 14. Februar 2016</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="/portal/customer-reviews/1523968915/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Formatieren: Taschenbuch</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verifizierter Kauf</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-4"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-4-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-4-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="peekExpand" name="a-cardui-deck-autoname-4-card0" data-csa-c-id="14twqq-dlslsv-liovou-ejupu4"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="de-DE" class="_Y3Itd_contain-rich-content_2IORW"><p><span>Nach dem ersten Teil von Echtzeit war ich echt schon überrascht und begeistert ohne Ende.</span></p><p><span>Nie hätte ich gedacht, dass der erste Teil noch getoppt werden kann. Doch er kann es!</span></p><p><span>Ein absolut herausragendes Werk!</span></p><p><span></span></p><p><span>Beginnen wir mit dem Inhalt.</span></p><p><span>Wie im ersten Teil geht es um Timmm mit drei 'm', den genialen Hacker, der leider gewisse Schwierigkeiten mit seinem Vormund hat. Er muss sich zunächst nur gegen seinen Betreuer Sigi wehren.... und dann noch gegen viel größeres!</span></p><p><span>Auch geht es um den (ehemaligen) Polizisten Hagen, der im ersten Teil schon eine sehr wichtige Rolle spielte.... leider wurde er "strafversetzt"...zum Krötenzählen und behüten. Eigentlich doch ziemlich entspannt oder? Denkste!</span></p><p><span>Und natürlich ist da noch die "Hausfrau" Claire.... die ein ziemlich abenteuerliches Doppelleben führt.</span></p><p><span>Alle Wege kreuzen sich, als ein vermeintlicher Terroranschlag das Land in Schrecken versetzt. Ein Umwelt-Terroranschlag. Aber war es eigentlich einer? Oder was geht da schon wieder ab?</span></p><p><span></span></p><p><span>Versprochen: Auch der zweite Teil von Echtzeit brilliert mit viel Spannung und Action, einer fesselnden und mitreissenden Story in unglaublich genialem Schreibstil und einer guten Portion Humor. Ein absoluter Bestseller, den man gelesen haben MUSS! Ich freu mich auf den nächsten Teil!</span></p><p><span>Eines der besten Bücher, das ich in der letzten Zeit gelesen habe! Hut ab und nur zu empfehlen!!</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="dljizl-je8x15-xfhsbk-opl4lp"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text">Mehr erfahren</span><span class="a-see-less-text">Weniger anzeigen</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-top-small _Y3Itd_helpful-votes-container_3iphI"><span data-hook="helpful-vote-statement" class="a-size-base a-color-tertiary">8&nbsp;Personen fanden dies hilfreich</span></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vote-action-bar_10AyR"><div data-hook="helpfulVoteWidget" class="a-section a-spacing-none _Y3Itd_cr-voting-section_1cNTp"><div class="_Y3Itd_cr-helpful-button_1u3UK cr-vote-component" data-hook="helpfulVoteButton" data-mix-operations="HelpfulVoteClickHandler" data-asin="1523968915" data-id="R25P6ECO7E5G6M" data-return-to="DpReview" data-csa-c-type="element" data-csa-c-slot-id="customer_review-R25P6ECO7E5G6M_helpful_button" data-csa-c-id="ud82jr-h49mm-r1wr6e-yw5s8u"><span class="a-button a-button-base" id="a-autoid-24"><span class="a-button-inner"><input type="submit" class="a-button-input" aria-labelledby="a-autoid-24-announce"><span class="a-button-text" aria-hidden="true" id="a-autoid-24-announce"><div class="_Y3Itd_cr-helpful-text-desktop_2dXQG">Hilfreich</div></span></span></span></div><span data-hook="helpfulVoteLoadingMessage" class="_Y3Itd_hidden_1J5OD">Feedback wird gesendet&nbsp;...</span><div data-hook="helpfulVoteSuccessMessage" class="a-box a-alert-inline a-alert-inline-success _Y3Itd_hidden_1J5OD a-spacing-block" aria-live="polite" aria-atomic="true"><div class="a-box-inner a-alert-container"><i class="a-icon a-icon-alert" aria-hidden="true"></i><div class="a-alert-content">Vielen Dank für dein Feedback.</div></div></div><div data-hook="helpfulVoteErrorMessage" class="a-box a-alert-inline a-alert-inline-error _Y3Itd_hidden_1J5OD a-spacing-block" role="alert"><div class="a-box-inner a-alert-container"><i class="a-icon a-icon-alert" aria-hidden="true"></i><div class="a-alert-content">Leider konnten wir deine Stimmabgabe nicht speichern. Bitte versuche es erneut</div></div></div></div><i aria-hidden="true" class="a-icon a-icon-text-separator" role="img" aria-label="|"></i><div data-hook="reportAbuseButton" data-mix-operations="ReportAbuseClickHandler" data-asin="1523968915" data-id="R25P6ECO7E5G6M" data-return-to="DpReview" data-csa-c-type="element" data-csa-c-slot-id="customer_review-R25P6ECO7E5G6M_report_button" data-csa-c-id="58hjcx-xc9ibb-jupani-imgghy"><a aria-label="Rezension melden" class="a-size-base a-link-normal a-color-secondary a-text-normal" href="javascript:void(0)" role="button">Melden</a></div><span data-hook="reportAbuseSendingMessage" class="_Y3Itd_hidden_ySuSy">Feedback wird gesendet&nbsp;...</span><div data-hook="reportAbuseSuccessMessage" class="a-box a-alert-inline a-alert-inline-success _Y3Itd_hidden_ySuSy a-spacing-block" aria-live="polite" aria-atomic="true"><div class="a-box-inner a-alert-container"><i class="a-icon a-icon-alert" aria-hidden="true"></i><div class="a-alert-content">Vielen Dank, wir werden die Angelegenheit in den nächsten Tagen überprüfen.</div></div></div><div data-hook="reportAbuseErrorMessage" class="a-box a-alert-inline a-alert-inline-error _Y3Itd_hidden_ySuSy a-spacing-block" role="alert"><div class="a-box-inner a-alert-container"><i class="a-icon a-icon-alert" aria-hidden="true"></i><div class="a-alert-content">Es tut uns leid, aber wir konnten diese Rezension nicht melden. Bitte versuche es erneut.</div></div></div></div></div></div><div id="cr-review-media-popover-R25P6ECO7E5G6M" class="aok-hidden"><div class="a-section _Y3Itd_media-popover-container_2Vf8U"><div class="_Y3Itd_media-popover-list-container_38-H0"><div class="_Y3Itd_media-popover-container-overlay_1nuZ1" data-hook="ReviewMediaPopover" id="review-media-popover-content-R25P6ECO7E5G6M"><div class="_Y3Itd_media-popover-content-wrapper_3MziH"><div class="_Y3Itd_media-popover-background-wrapper_2UMSb"><div class="_Y3Itd_page-indicator-container_1X84N"><div class="_Y3Itd_media-popover-page-indicator_10KaA" data-hook="PageIndicator"></div></div><div class="_Y3Itd_media-popover-topbar_knKqX"><button data-popover-id="R25P6ECO7E5G6M" class="_Y3Itd_close-button_2RG2d" data-hook="ReviewMediaPopoverCloseButton" data-mix-operations="ReviewMediaPopoverCloseButtonClickHandler" data-csa-c-type="element" data-csa-c-id="ujvv2e-3ry0zl-pleyai-b8uykf"><i class="a-icon a-icon-close-white a-icon-medium" role="presentation"></i></button></div><div class="_Y3Itd_media-popover-media-list-view-container_1kFg1" data-hook="ReviewMediaList"><button data-popover-id="R25P6ECO7E5G6M" class="_Y3Itd_media-popover-media-list-overlay_2x3M5" data-mix-operations="ReviewMediaPopoverNextMediaClickHandler"></button></div></div></div></div></div></div></div></div></span></li><li><span class="a-list-item"><div data-hook="reviewContainer" data-translatable="false" data-reviewid="R1FGV5ALNJ4MQ5" data-asin="B01BLSRIX6" data-mobile="false" data-locale="de-DE" data-localelanguagename="Deutsch" data-sourcelanguage="de-DE" data-sourcelanguagename="Deutsch" data-iscustomerrecognized="false" data-iskindleapp="false" data-isandroidapp="false" data-isiosapp="false" data-ismshop="false" data-marketplaceid="A1PA6795UKMFR9"><div id="R1FGV5ALNJ4MQ5" data-csa-c-slot-id="customer_review-R1FGV5ALNJ4MQ5" data-csa-c-type="widget" data-hook="review" class="a-section aok-relative" data-csa-c-id="lwsozw-e004bm-7byu4w-2fqkri"><div data-hook="genome-widget" class="a-row a-spacing-mini"><a href="/gp/profile/amzn1.account.AFF6IKWBBIZJ43A3KSXTIUEYXDCA?ref=cm_cr_dp_d_bdcrb_top" data-csa-c-slot-id="customer_review-R1FGV5ALNJ4MQ5_profile" data-csa-c-type="element" class="a-profile _Y3Itd_profile-link_2n23E" data-a-size="small" data-csa-c-id="gy7d8f-zdtrfy-6mklx7-d9iicb"><div aria-hidden="true" class="a-profile-avatar-wrapper"><div class="a-profile-avatar"><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png" data-src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"><noscript><img src="https://m.media-amazon.com/images/S/amazon-avatars-global/default._SX48_.png"/></noscript></div></div><div class="a-profile-content"><span class="a-profile-name">Robi Roberto</span></div></a></div><div class="_Y3Itd_single-review-star-rating-bar-desktop_1T97A"><i data-hook="review-star-rating" class="a-icon a-icon-star a-star-5"><span class="a-icon-alt">5 von 5&nbsp;Sternen</span></i><span class="a-letter-space"></span></div><a class="a-size-base a-color-base a-link-normal a-text-bold" href="/portal/customer-reviews/srp/-/R1FGV5ALNJ4MQ5/ref=cm_cr_dp_d_rvw_ttl?_encoding=UTF8&amp;ie=UTF8"><h5 class="_Y3Itd_single-review-title_2aKRE" data-hook="reviewTitle" lang="de-DE">Nichts ist flexibler als die Wahrheit</h5></a><div data-hook="review-by-line" class="a-row a-spacing-none"><span data-hook="review-date" class="a-size-base a-color-tertiary">Bewertet in Deutschland am 5. Dezember 2017</span></div><div data-hook="product-variation-attributes" class="a-row a-spacing-mini"><a data-hook="format-strip" class="a-link-normal" href="/portal/customer-reviews/B01BLSRIX6/ref=cm_cr_dp_d_rvw_fmt?_encoding=UTF8&amp;formatType=current_format"><span class="a-size-base a-color-secondary">Formatieren: Kindle</span></a><i class="a-icon a-icon-text-separator" role="presentation"></i><span class="_Y3Itd_inline-contributor_33jDb"><div data-hook="review-badges"><a class="a-link-normal" href="/gp/help/customer/display.html/ref=cm_cr_dp_d_rvw_avp?ie=UTF8&amp;nodeId=G8UYX7LALQC8V9KA"><span data-hook="avp-badge" class="a-size-mini a-color-state a-text-bold">Verifizierter Kauf</span></a></div></span></div><div data-hook="reviewTextContainer" class="_Y3Itd_single-review-text-container_325WM"><div data-hook="reviewText" class="a-cardui-deck _Y3Itd_card-deck_37S9P" data-a-remove-top-gutter="true" data-a-remove-bottom-gutter="true" name="a-cardui-deck-autoname-5"><div class="a-teaser-describedby-collapsed a-hidden" id="a-cardui-deck-autoname-5-teaser-describedby-collapsed">Brief content visible, double tap to read full content.</div><div class="a-teaser-describedby-expanded a-hidden" id="a-cardui-deck-autoname-5-teaser-describedby-expanded">Full content visible, double tap to read brief content.</div><div data-csa-c-slot-id="true" data-csa-c-type="element" class="a-cardui _Y3Itd_peek-expand_3G9Ub" data-a-card-type="peekExpand" name="a-cardui-deck-autoname-5-card0" data-csa-c-id="896ii6-xhltnn-g379bl-5a7gz8"><div class="a-cardui-body _Y3Itd_no-padding_1A9ha"><div class="a-reactive-container a-reactive-container-transition"><div><div class="a-cardui-content a-cardui-uninitialized" data-a-max-height="300"><div class="_Y3Itd_relative_1SChh"><div data-hook="reviewRichContentContainer" lang="de-DE" class="_Y3Itd_contain-rich-content_2IORW"><p><span>"EchtzeiT - Wer die Wahrheit quält" ist der zweite Teil der EchtzeiT-Trilogie von Sam Feuerbach und Thariot. Die Handlung spielt im Jahr 2024 und setzt drei Monate nach dem ersten Band ein. Diesmal geht es um eine stark steigende Anzahl misteriöser Vergiftungsfälle durch das Trinkwasser, für die ein islamischtischer Terroranschlag vermutet wird.</span></p><p><span></span></p><p><span>Die Handlung wird wie bei Band eins aus Perspektive der drei Hauptakteure Timmm (dem 17-jährigen Studenten und IT-Genie), Claire (der ehemaligen Mossad-Agentin) und Hagen Melzer (der von der Kripo inzwischen zum EU-Bundesamt versetzt worden ist) erzählt.</span></p><p><span></span></p><p><span>Die Geschichte ist sehr spannend, ziemlich actionreich und mitunter sehr blutig. Die Auflösung ist schließlich plausibel und nicht so konstruiert wie im ersten Band.</span></p><p><span></span></p><p><span>Erneut fand ich die Figur von Claire, die ein geheimnisvolles Doppelleben führt, am interessantesten. Auf der einen Seite ist sie treusorgende Mutter, auf der anderen Seite eine skrupellose Agentin.</span></p><p><span></span></p><p><span>Einzig die allzu genialen Hackerfähigkeiten Timmms (der sich in Sekundenschnelle überall einhackt und sofort alles überblickt) fand ich etwas übertrieben. Aber insgesamt ist der zweite Teil der Trilogie sehr gelungen und ich bin gespannt, wie der Mord an der jungen Melanie aus dem ersten Band im abschließenden dritten Teil aufgeklärt wird.</span></p></div></div></div></div><div class="a-reactive-container-gradient"></div></div></div><div data-hook="reviewExpandButtonContainer" class="a-cardui-footer _Y3Itd_no-padding_1A9ha"><div class="a-cardui-expand-control-footer _Y3Itd_read-more-less_2uDYd" data-csa-c-type="widget" data-csa-interaction-events="click" data-csa-c-id="hv5sqv-bajwhc-lr14dw-3g1jeb"><a href="javascript:void(0)" class="a-cardui-expand-control-footer-button" role="button"><span class="a-expander-icon"><i class="a-css-icon a-css-icon-draw a-css-icon-expand"></i></span><span class="a-see-more a-color-link"><span class="a-see-more-text">Mehr erfahren</span><span class="a-see-less-text">Weniger anzeigen</span></span></a></div></div></div></div><div data-hook="translationSpinner" class="_Y3Itd_single-review-translation-spinner-container_ypxf2"><div class="a-spinner-wrapper _Y3Itd_single-review-translation-spinner_1tBUJ"><span class="a-spinner a-spinner-medium"></span></div></div></div><div class="a-section a-spacing-top-small _Y3Itd_helpful-votes-container_3iphI"><span data-hook="helpful-vote-statement" class="a-size-base a-color-tertiary">Eine Person fand diese Informationen hilfreich</span></div><div class="a-section a-spacing-small a-spacing-top-small"><div class="_Y3Itd_single-review-vote-action-bar_10AyR"><div data-hook="helpfulVoteWidget" class="a-section a-spacing-none _Y3Itd_cr-voting-section_1cNTp"><div class="_Y3Itd_cr-helpful-button_1u3UK cr-vote-component" data-hook="helpfulVoteButton" data-mix-operations="HelpfulVoteClickHandler" data-asin="B01BLSRIX6" data-id="R1FGV5ALNJ4MQ5" data-return-to="DpReview" data-csa-c-type="element" data-c