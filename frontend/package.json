{
  "name": "grimmory",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "dev": "ng serve --open --watch --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "coverage": "ng test --watch=false --coverage",
    "coverage:summary": "node ./scripts/coverage-summary.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run lint:styles",
    "lint:oxlint": "oxlint src",
    "lint:oxlint:ci": "oxlint src --format json",
    "lint:oxlint:fix": "oxlint src --fix",
    "lint:eslint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
    "lint:prune": "oxlint src --prune-suppressions && eslint --prune-suppressions \"src/**/*.ts\" \"src/**/*.html\"",
    "lint:styles": "stylelint \"src/**/*.scss\" \"src/*.scss\"",
    "lint:styles:fix": "pnpm run lint:styles --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/service-worker": "^22.2.2",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/snippet": "2.15.1",
    "@jsverse/transloco": "^8.4.0",
    "@lucide/angular": "^1.56.0",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "@stomp/rx-stomp": "^2.4.0",
    "@stomp/stompjs": "^7.4.0",
    "@tanstack/angular-query-experimental": "5.104.2",
    "@tanstack/angular-table": "9.3.1",
    "@tanstack/angular-virtual": "^6.1.4",
    "chart.js": "^4.5.1",
    "chartjs-chart-matrix": "3.0.5",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "lucide-static": "1.56.0",
    "markdown-it": "^15.0.2",
    "ng-lazyload-image": "^9.1.3",
    "ng2-charts": "^10.0.0",
    "ngx-infinite-scroll": "^22.0.0",
    "ngx-sse-client": "^21.0.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.8.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.2",
    "@angular-devkit/schematics": "^22.2.2",
    "@angular/build": "22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@openng/optimus-ui-tailwindcss": "^2.0.2",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-oxlint": "1.87.0",
    "jsdom": "^30.1.2",
    "ng-mocks": "^14.18.1",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "^8.5.30",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
