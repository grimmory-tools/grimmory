{
  "name": "grimmory",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "dev": "ng serve --open --watch --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "coverage": "ng test --watch=false --coverage",
    "coverage:summary": "node ./scripts/coverage-summary.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "pnpm run lint:code && pnpm run lint:styles",
    "lint:code": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "oxlint src",
    "lint:oxlint:ci": "oxlint src --format json",
    "lint:oxlint:fix": "oxlint src --fix",
    "lint:oxlint:strict": "oxlint src --deny-warnings",
    "lint:eslint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.scss\" \"src/*.scss\"",
    "lint:styles:fix": "pnpm run lint:styles --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "~21.2.14",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/service-worker": "^21.2.19",
    "@embedpdf/pdfium": "2.15.0",
    "@embedpdf/snippet": "2.15.0",
    "@jsverse/transloco": "^8.4.0",
    "@lucide/angular": "^1.31.0",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^1.0.1",
    "@openng/optimus-ui-themes": "^1.0.1",
    "@stomp/rx-stomp": "^2.4.0",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/angular-query-experimental": "5.101.4",
    "@tanstack/angular-table": "^8.21.4",
    "@tanstack/angular-virtual": "^6.0.2",
    "chart.js": "^4.5.1",
    "chartjs-chart-matrix": "3.0.5",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "lucide-static": "1.31.0",
    "markdown-it": "^15.0.0",
    "ng-lazyload-image": "^9.1.3",
    "ng2-charts": "^10.0.0",
    "ngx-infinite-scroll": "^21.0.0",
    "ngx-sse-client": "^21.0.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular-devkit/architect": "0.2102.20",
    "@angular-devkit/schematics": "21.2.20",
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@eslint/js": "^10.0.1",
    "@openng/optimus-ui-tailwindcss": "1.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.76.0",
    "jsdom": "^30.0.1",
    "ng-mocks": "^14.17.0",
    "@oxlint/plugins": "^1.78.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.26",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "vitest-canvas-mock": "^1.1.4"
  }
}
